/* ═══════════════════════════════════════════════
   VALIDATION ENGINE
═══════════════════════════════════════════════ */
const SPAM_WORDS = /^(test|testing|dummy|fake|asdf|qwerty|qwer|abcd|abcde|abc|xyz|user|admin|sample|demo|hello|hi|none|na|n\/a|null|undefined|noreply|no-reply|nobody|someone|anything|something|blah)$/i
const ALL_SAME   = (s) => s.length > 1 && s.split('').every(c => c === s[0])
const isFake     = (v) => SPAM_WORDS.test(v.trim()) || ALL_SAME(v.replace(/\s/g, ''))

const vName = (v) => {
  const s = v.trim()
  if (!s)                           return 'Full name is required.'
  if (/[^a-zA-Z\s'.\-]/.test(s))   return 'Name must contain letters only — no numbers or symbols.'
  if (s.length < 3)                 return 'Name must be at least 3 characters.'
  if (s.length > 80)                return 'Name is too long.'
  if (!s.includes(' '))             return 'Please enter both your first and last name.'
  if (ALL_SAME(s.replace(/\s/g,'')))return 'Please enter your real name.'
  if (isFake(s.split(' ')[0]))      return 'Please enter your real full name.'
  return ''
}

const BLOCKED_PHONES = new Set([
  '1111111111','2222222222','3333333333','4444444444','5555555555',
  '6666666666','7777777777','8888888888','9999999999','0000000000',
  '1234567890','9876543210','1234512345','9876598765','0123456789',
])
const vPhone = (v) => {
  const d = v.replace(/\D/g, '')
  if (!d)          return 'Phone number is required.'
  if (d.length < 10) return `${10 - d.length} more digit(s) needed.`
  if (d.length > 10) return 'Phone number must be exactly 10 digits.'
  if (!/^[6-9]/.test(d)) return 'Indian mobile numbers must start with 6, 7, 8, or 9.'
  if (BLOCKED_PHONES.has(d)) return 'Please enter a valid phone number.'
  return ''
}

const DISPOSABLE = ['mailinator','guerrillamail','throwam','sharklasers','trashmail','yopmail','getnada','tempmail','dispostable','fakeinbox','mailnull','spamgourmet','tempr','maildrop','getairmail','discard','fakemail']
const BAD_LOCAL  = /^(test|testing|dummy|fake|spam|asdf|qwer|1234|abcd|user|admin|noreply|no-reply|nobody|someone|example|sample)/i
const BAD_TLD    = /\.(con|cmo|ocm|vom|nte|met|ogr)$/i

const vEmail = (v) => {
  const s = v.trim().toLowerCase()
  if (!s) return 'Email address is required.'
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(s)) return 'Enter a valid email address (e.g. chandan@gmail.com).'
  const [local, domain] = s.split('@')
  if (!domain)                                    return 'Enter a valid email address.'
  if (BAD_LOCAL.test(local))                      return 'Please use your real email address.'
  if (DISPOSABLE.some(d => domain.includes(d)))   return 'Disposable email addresses are not accepted.'
  if (BAD_TLD.test(s))                            return 'Check your email domain (e.g. .com, .in, .org).'
  if (ALL_SAME(local))                            return 'Please enter a valid email address.'
  return ''
}

const vPosition    = (v) => v ? '' : 'Please select a position.'
const vExperience  = (v) => {
  const s = v.trim()
  if (!s)       return 'Experience is required.'
  if (isFake(s)) return 'Please enter your actual experience.'
  if (!/^(\d{1,2}(\.\d{1,2})?|\d{1,2}\s*[-–]\s*\d{1,2})(\+)?\s*(years?|yrs?)?$/i.test(s) && !/^\d{1,2}(\.\d)?$/.test(s))
    return 'Enter experience in years (e.g. 5, 3.5, 2–4, 8+).'
  const n = parseFloat(s)
  if (!isNaN(n) && n > 50) return 'Experience cannot exceed 50 years.'
  return ''
}

const vSalary = (label) => (v) => {
  const s = v.trim()
  if (!s)        return `${label} is required.`
  if (isFake(s)) return `Please enter a valid ${label.toLowerCase()}.`
  const n = parseFloat(s.replace(/[,\s₹LlKkPApa lakhlakhs]/g, ''))
  if (isNaN(n) || n <= 0) return 'Enter a valid salary amount (e.g. 6 LPA or 600000).'
  if (n < 1000 && !/[lL]/i.test(s)) return 'Amount seems too low — use ₹ or LPA format.'
  return ''
}

const vLocation = (v) => {
  const s = v.trim()
  if (!s)                          return 'Current location is required.'
  if (s.length < 2)                return 'Enter a valid city or location.'
  if (/[^a-zA-Z\s,.\-]/.test(s))  return 'Location should contain letters only.'
  if (isFake(s))                   return 'Please enter your actual location.'
  return ''
}

const vRelocate = (v) => v ? '' : 'Please select your relocation preference.'

const vNotice = (v) => {
  const s = v.trim()
  if (!s)        return 'Notice period is required.'
  if (isFake(s)) return 'Please enter your actual notice period.'
  if (!/^(immediate(ly)?|0|serving|\d{1,3}\s*(days?|weeks?|months?|day|week|month))$/i.test(s))
    return 'e.g. Immediate, 30 days, 2 months, Serving notice.'
  return ''
}

const vDescription = (v) => {
  const s = v.trim()
  if (!s)          return 'Please provide a short description.'
  if (s.length < 20) return `At least 20 characters needed (${20 - s.length} more).`
  if (s.length > 1000) return 'Maximum 1000 characters allowed.'
  if (ALL_SAME(s.replace(/\s/g,''))) return 'Please write a meaningful description.'
  if (isFake(s))   return 'Please describe your experience and suitability for the role.'
  return ''
}

const ALLOWED_EXTS = ['.pdf', '.doc', '.docx']
const BLOCKED_EXTS = ['.exe','.bat','.sh','.js','.php','.py','.rb','.cmd','.vbs','.ps1','.jar','.zip','.rar','.7z','.msi','.dmg','.apk','.html','.htm']
const MAX_SIZE     = 5 * 1024 * 1024

const vResume = (file) => {
  if (!file) return 'Please upload your resume.'
  const n = file.name.toLowerCase()
  if (BLOCKED_EXTS.some(e => n.endsWith(e))) return 'This file type is not allowed for security reasons.'
  if (!ALLOWED_EXTS.some(e => n.endsWith(e))) return 'Only PDF, DOC, or DOCX files are accepted.'
  if (file.size > MAX_SIZE) return 'File size must not exceed 5MB.'
  if (file.size < 500)      return 'File appears empty or corrupted.'
  return ''
}

const VALIDATORS = {
  fullName:    vName,
