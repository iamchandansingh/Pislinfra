const EMPTY = {
  fullName:'', phone:'', email:'', position:'',
  experience:'', currentCTC:'', inHand:'', expectedCTC:'',
  location:'', relocate:'', noticePeriod:'', description:'', resume:null,
}

const Careers = () => {

  const [page, setPage] = useState(1)
  const PER = 10
  const totalPages  = Math.ceil(JOBS.length / PER)
  const visibleJobs = JOBS.slice((page-1)*PER, page*PER)

  const [form,       setForm]       = useState(EMPTY)
  const [errors,     setErrors]     = useState({})
  const [touched,    setTouched]    = useState({})
  const [submitting, setSubmitting] = useState(false)
  const [done,       setDone]       = useState(false)
  const [locked,     setLocked]     = useState(false)

  const formRef = useRef(null)

  useEffect(() => {
    let timer
    if (done) {
      timer = setTimeout(() => {
        setDone(false)
        setLocked(false)
        setForm(EMPTY)
        setErrors({})
        setTouched({})
      }, 10000)
    }
    return () => clearTimeout(timer)
  }, [done])

  /* ── Apply Now → ONLY Position + Notice Period auto-fill ── */
  const handleApplyClick = useCallback((job) => {
    const pos = POSITIONS.includes(job.title) ? job.title : 'Other'
    
    setForm({ 
      ...EMPTY,
      position: pos,
      noticePeriod: '30 days'
    })
    
    setErrors({})
    setTouched({})
    setDone(false)
    setLocked(false)
    
    setTimeout(() => formRef.current?.scrollIntoView({ behavior:'smooth', block:'start' }), 60)
  }, [])

  const handleChange = useCallback((e) => {
    const { name, value } = e.target

    if (name === 'phone') {
      const digits = value.replace(/\D/g, '').slice(0, 10)
      setForm(prev => ({ ...prev, phone: digits }))
      if (touched.phone) setErrors(prev => ({ ...prev, phone: vPhone(digits) }))
      return
    }

    setForm(prev => ({ ...prev, [name]: value }))
    if (touched[name]) {
      setErrors(prev => ({ ...prev, [name]: VALIDATORS[name] ? VALIDATORS[name](value) : '' }))
    }
  }, [touched])

  const handleFileChange = useCallback((e) => {
    const file = e.target.files[0] || null
    setForm(prev => ({ ...prev, resume: file }))
    setTouched(prev => ({ ...prev, resume: true }))
    setErrors(prev => ({ ...prev, resume: vResume(file) }))
  }, [])

  const handleBlur = useCallback((e) => {
    const { name } = e.target
    const val = name === 'phone' ? form.phone : e.target.value
    setTouched(prev => ({ ...prev, [name]: true }))
    setErrors(prev => ({ ...prev, [name]: VALIDATORS[name] ? VALIDATORS[name](val) : '' }))
  }, [form.phone])

  const handleSubmit = useCallback((e) => {
    e.preventDefault()
    if (submitting || locked) return

    const allTouched = Object.keys(VALIDATORS).reduce((a,k) => ({ ...a, [k]:true }), {})
    const allErrors  = Object.keys(VALIDATORS).reduce((a,k) => {
      const val = k === 'resume' ? form.resume : form[k]
      return { ...a, [k]: VALIDATORS[k](val) }
    }, {})

    setTouched(allTouched)
    setErrors(allErrors)

    if (Object.values(allErrors).some(Boolean)) {
      setTimeout(() => {
        const el = formRef.current?.querySelector('[data-invalid="true"]')
        el?.scrollIntoView({ behavior:'smooth', block:'center' })
      }, 50)
      return
    }

    setSubmitting(true)
    setTimeout(() => {
      setSubmitting(false)
      setDone(true)
      setLocked(true)
    }, 1800)
  }, [form, submitting, locked])

  return (
    <div style={{ fontFamily:'inherit', background:S.bgPage, minHeight:'100vh' }}>

      {/* HERO */}
      <PageHero
        title="Careers"
        subtitle="Join PISL INFRA and build tomorrow's India with us."
        breadcrumb="Careers"
        bgImage="/images/hero/Careers.png"
      />

      {/* WHY JOIN */}
      <section style={{ padding:'80px 24px', backgroundColor:S.white }}>
        <div style={{ maxWidth:'1280px', margin:'0 auto' }}>
          <div style={{ textAlign:'center', marginBottom:'48px' }}>
            <h2 style={{ fontSize:'30px', fontWeight:'bold', color:S.navy, margin:'0 0 8px' }}>
              Why Join <span style={{ color:S.orange }}>PISL?</span>
            </h2>
            <div style={{ width:'60px', height:'3px', backgroundColor:S.orange, margin:'0 auto' }} />
          </div>
          <div style={{ display:'grid', gridTemplateColumns:'repeat(auto-fit, minmax(300px,1fr))', gap:'32px' }}>
            {WHY_JOIN.map((item,i) => (
              <div key={i}
                style={{ backgroundColor:S.bgPage, padding:'40px 32px', borderRadius:'24px', border:`1px solid ${S.border}`, textAlign:'center', transition:'transform .3s' }}
                onMouseEnter={e => e.currentTarget.style.transform='translateY(-6px)'}
                onMouseLeave={e => e.currentTarget.style.transform='translateY(0)'}
              >
                <div style={{ width:'64px', height:'64px', backgroundColor:S.white, borderRadius:'16px', display:'flex', alignItems:'center', justifyContent:'center', margin:'0 auto 24px', boxShadow:'0 10px 30px rgba(0,0,0,0.04)' }}>
                  <item.icon style={{ fontSize:'28px', color:S.orange }} />
                </div>
                <h3 style={{ fontSize:'22px', fontWeight:'bold', color:S.navy, marginBottom:'12px' }}>{item.title}</h3>
                <p style={{ color:S.textMuted, fontSize:'15px', lineHeight:'1.6', margin:0 }}>{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CURRENT OPENINGS */}
      <section style={{ padding:'80px 24px', backgroundColor:S.bgPage }}>
        <div style={{ maxWidth:'1280px', margin:'0 auto' }}>
          <div style={{ textAlign:'center', marginBottom:'48px' }}>
            <h2 style={{ fontSize:'30px', fontWeight:'bold', color:S.navy, margin:'0 0 8px' }}>
              Current <span style={{ color:S.orange }}>Openings</span>
            </h2>
            <div style={{ width:'60px', height:'3px', backgroundColor:S.orange, margin:'0 auto' }} />
          </div>

          <div style={{ backgroundColor:S.white, borderRadius:'24px', border:`1px solid ${S.border}`, overflow:'hidden', boxShadow:'0 10px 40px rgba(0,0,0,0.02)' }}>
            <div style={{ overflowX:'auto' }}>
              <table style={{ width:'100%', borderCollapse:'collapse', textAlign:'left', minWidth:'900px' }}>
                <thead>
                  <tr style={{ backgroundColor:'#f1f5f9', borderBottom:`2px solid ${S.border}` }}>
                    {['Job Title','Department','Experience','Qualification','Location','Action'].map((h,i) => (
                      <th key={i} style={{ padding:'20px 24px', color:S.navy, fontSize:'13px', fontWeight:'bold', textTransform:'uppercase', letterSpacing:'1px', textAlign: i===5?'center':'left' }}>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {visibleJobs.map(job => (
                    <tr key={job.id}
                      style={{ borderBottom:`1px solid ${S.border}`, transition:'background .2s' }}
                      onMouseEnter={e => e.currentTarget.style.backgroundColor='#fff8f5'}
                      onMouseLeave={e => e.currentTarget.style.backgroundColor='transparent'}
                    >
                      <td style={{ padding:'20px 24px', fontWeight:'bold', color:S.navy, fontSize:'15px' }}>{job.title}</td>
                      <td style={{ padding:'20px 24px', color:S.textMuted, fontSize:'14px' }}>{job.dept}</td>
                      <td style={{ padding:'20px 24px', color:S.textMuted, fontSize:'14px' }}>{job.exp}</td>
                      <td style={{ padding:'20px 24px', color:S.textMuted, fontSize:'14px' }}>{job.qual}</td>
                      <td style={{ padding:'20px 24px', color:S.textMuted, fontSize:'14px' }}>{job.loc}</td>
                      <td style={{ padding:'20px 24px', textAlign:'center' }}>
                        <button
                          onClick={() => handleApplyClick(job)}
                          style={{ display:'inline-block', backgroundColor:S.navy, color:S.white, padding:'8px 16px', borderRadius:'8px', fontSize:'13px', fontWeight:'bold', border:'none', cursor:'pointer', transition:'background .2s' }}
                          onMouseEnter={e => e.currentTarget.style.backgroundColor=S.orange}
                          onMouseLeave={e => e.currentTarget.style.backgroundColor=S.navy}
                        >
                          Apply Now
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div style={{ padding:'20px 24px', display:'flex', justifyContent:'space-between', alignItems:'center', backgroundColor:'#f8f9fc', borderTop:`1px solid ${S.border}`, flexWrap:'wrap', gap:'12px' }}>
              <span style={{ fontSize:'14px', color:S.textMuted, fontWeight:'600' }}>
                Showing {(page-1)*PER+1}–{Math.min(page*PER, JOBS.length)} of {JOBS.length} entries
              </span>
              <div style={{ display:'flex', gap:'8px' }}>
                <PagBtn onClick={() => setPage(p=>Math.max(1,p-1))} disabled={page===1}><HiChevronLeft /></PagBtn>
                {Array.from({length:totalPages},(_,i)=>i+1).map(n => (
                  <PagBtn key={n} onClick={() => setPage(n)} active={page===n}>{n}</PagBtn>
                ))}
                <PagBtn onClick={() => setPage(p=>Math.min(totalPages,p+1))} disabled={page===totalPages}><HiChevronRight /></PagBtn>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* HIRING PROCESS */}
      <section style={{ padding:'80px 24px', backgroundColor:S.white }}>
        <div style={{ maxWidth:'1280px', margin:'0 auto' }}>
          <div style={{ textAlign:'center', marginBottom:'60px' }}>
            <h2 style={{ fontSize:'30px', fontWeight:'bold', color:S.navy, margin:0 }}>
              Our Hiring <span style={{ color:S.orange }}>Process</span>
            </h2>
            <div style={{ width:'60px', height:'3px', backgroundColor:S.orange, margin:'16px auto 0' }} />
          </div>
          <div style={{ display:'grid', gridTemplateColumns:'repeat(auto-fit, minmax(200px,1fr))', gap:'32px' }}>
            {HIRING_PROCESS.map((item,i) => (
              <div key={i} style={{ textAlign:'center' }}>
                <div style={{ position:'relative', width:'90px', height:'90px', margin:'0 auto 24px' }}>
                  <div style={{ position:'absolute', inset:0, border:`2px dashed ${S.orange}`, borderRadius:'50%', animation:'spinDash 15s linear infinite' }} />
                  <div style={{ position:'absolute', inset:'8px', backgroundColor:S.bgPage, borderRadius:'50%', display:'flex', alignItems:'center', justifyContent:'center', color:S.navy, fontSize:'24px', fontWeight:'bold', boxShadow:'0 4px 10px rgba(0,0,0,0.05)', zIndex:2 }}>
                    {item.step}
                  </div>
                </div>
                <h4 style={{ color:S.navy, fontSize:'18px', fontWeight:'bold', margin:'0 0 12px' }}>{item.title}</h4>
                <p style={{ color:S.textMuted, fontSize:'14px', lineHeight:'1.6', margin:0 }}>{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* FORM + CONTACT */}
      <section id="apply-form" ref={formRef} style={{ padding:'80px 24px', backgroundColor:S.bgPage }}>
        <div style={{ maxWidth:'1280px', margin:'0 auto', display:'grid', gridTemplateColumns:'1.5fr 1fr', gap:'40px', alignItems:'start' }}>

          {/* APPLICATION FORM */}
          <div style={{ backgroundColor:S.white, borderRadius:'24px', padding:'48px', border:`1px solid ${S.border}`, boxShadow:'0 20px 50px rgba(0,0,0,0.03)' }}>
            {done ? (
              <div style={{
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                minHeight: '500px'
              }}>
                <SuccessState name={form.fullName} position={form.position} />
              </div>
            ) : (
              <form onSubmit={handleSubmit} noValidate>
                <div style={{ marginBottom:'36px' }}>
                  <h3 style={{ fontSize:'30px', fontWeight:'bold', color:S.navy, margin:'0 0 8px' }}>
                    Career With <span style={{ color:S.orange }}>PISL</span>
                  </h3>
                  <p style={{ color:S.textMuted, fontSize:'15px', margin:0 }}>Fill out the details below to apply for a position.</p>
                </div>

                <div style={{ display:'grid', gap:'20px' }}>

                  {/* Row 1: Full Name + Phone */}
                  <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:'20px' }}>
                    <div data-invalid={touched.fullName && !!errors.fullName ? 'true' : undefined}>
                      <VInput
                        label="Full Name" name="fullName" value={form.fullName}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.fullName} touched={touched.fullName}
                        required placeholder="e.g. Aayush Soni"
                      />
                    </div>
                    <div data-invalid={touched.phone && !!errors.phone ? 'true' : undefined}>
                      <FieldLabel text="Phone Number" required />
                      <div style={{ position:'relative' }}>
                        <input
                          type="tel" name="phone" value={form.phone}
                          inputMode="numeric" maxLength={10}
                          onChange={handleChange}
                          onBlur={(e) => {
                            handleBlur(e)
                            const err = vPhone(form.phone)
                            Object.assign(e.target.style, touched.phone
                              ? (err ? invalidStyle : validStyle)
                              : { borderColor:'transparent', backgroundColor:'#f1f5f9', boxShadow:'none' })
                          }}
                          onFocus={(e) => Object.assign(e.target.style, focusStyle)}
                          placeholder="10-digit mobile number"
                          autoComplete="off"
                          style={{ ...getFieldStyle(touched.phone, errors.phone), paddingRight: touched.phone ? '38px':'16px' }}
                        />
                        <InlineIcon touched={touched.phone} error={errors.phone} />
                      </div>
                      <div style={{ display:'flex', justifyContent:'space-between', alignItems:'flex-start' }}>
                        <ValidationMsg error={errors.phone} touched={touched.phone} />
                        <span style={{ fontSize:'11px', color: form.phone.length===10 ? '#22c55e' : S.textMuted, marginLeft:'auto', marginTop:'5px', whiteSpace:'nowrap' }}>
                          {form.phone.length}/10
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* Row 2: Email + Position */}
                  <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:'20px' }}>
                    <div data-invalid={touched.email && !!errors.email ? 'true' : undefined}>
                      <VInput
                        label="Email" name="email" type="email" value={form.email}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.email} touched={touched.email}
                        required placeholder="e.g. aayush@gmail.com"
                      />
                    </div>
                    <div data-invalid={touched.position && !!errors.position ? 'true' : undefined}>
                      <VSelect
                        label="Position Applying For" name="position" value={form.position}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.position} touched={touched.position} required
                      >
                        <option value="">Select position</option>
                        {POSITIONS.map((p,i) => <option key={i} value={p}>{p}</option>)}
                      </VSelect>
                    </div>
                  </div>

                  {/* Row 3: Experience + Current CTC */}
                  <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:'20px' }}>
                    <div data-invalid={touched.experience && !!errors.experience ? 'true' : undefined}>
                      <VInput
                        label="Total Experience (Years)" name="experience" value={form.experience}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.experience} touched={touched.experience}
                        required placeholder="e.g. 5 or 3–5"
                      />
                    </div>
                    <div data-invalid={touched.currentCTC && !!errors.currentCTC ? 'true' : undefined}>
                      <VInput
                        label="Current Salary (CTC per annum)" name="currentCTC" value={form.currentCTC}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.currentCTC} touched={touched.currentCTC}
                        required placeholder="e.g. 6 LPA or 600000"
                      />
                    </div>
                  </div>

                  {/* Row 4: In-hand + Expected */}
                  <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:'20px' }}>
                    <div data-invalid={touched.inHand && !!errors.inHand ? 'true' : undefined}>
                      <VInput
                        label="Current In-hand Salary (Monthly)" name="inHand" value={form.inHand}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.inHand} touched={touched.inHand}
                        required placeholder="e.g. 45000"
                      />
                    </div>
                    <div data-invalid={touched.expectedCTC && !!errors.expectedCTC ? 'true' : undefined}>
                      <VInput
                        label="Expected Salary (per annum)" name="expectedCTC" value={form.expectedCTC}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.expectedCTC} touched={touched.expectedCTC}
                        required placeholder="e.g. 8 LPA"
                      />
                    </div>
                  </div>

                  {/* Row 5: Location + Relocate + Notice */}
                  <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr 1fr', gap:'20px' }}>
                    <div data-invalid={touched.location && !!errors.location ? 'true' : undefined}>
                      <VInput
                        label="Current Location" name="location" value={form.location}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.location} touched={touched.location}
                        required placeholder="e.g. Mumbai"
                      />
                    </div>
                    <div data-invalid={touched.relocate && !!errors.relocate ? 'true' : undefined}>
                      <VSelect
                        label="Can you relocate?" name="relocate" value={form.relocate}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.relocate} touched={touched.relocate} required
                      >
                        <option value="">Select</option>
                        <option>Yes</option>
                        <option>No</option>
                        <option>Open to Discussion</option>
                      </VSelect>
                    </div>
                    <div data-invalid={touched.noticePeriod && !!errors.noticePeriod ? 'true' : undefined}>
                      <VInput
                        label="Notice Period" name="noticePeriod" value={form.noticePeriod}
                        onChange={handleChange} onBlur={handleBlur}
                        error={errors.noticePeriod} touched={touched.noticePeriod}
                        required placeholder="30 days"
                      />
                    </div>
                  </div>

                  {/* Description */}
                  <div data-invalid={touched.description && !!errors.description ? 'true' : undefined}>
                    <FieldLabel text="Short Description" required />
                    <div style={{ position:'relative' }}>
                      <textarea
                        name="description" value={form.description}
                        onChange={handleChange}
                        onBlur={(e) => {
                          handleBlur(e)
                          const err = vDescription(form.description)
                          Object.assign(e.target.style, touched.description
                            ? (err ? invalidStyle : validStyle)
                            : { borderColor:'transparent', backgroundColor:'#f1f5f9', boxShadow:'none' })
                        }}
                        onFocus={(e) => Object.assign(e.target.style, focusStyle)}
                        required rows={3}
                        placeholder="Briefly describe your experience and why you're a great fit for this role…"
                        style={{ ...getFieldStyle(touched.description, errors.description), resize:'vertical', paddingRight:'38px' }}
                      />
                      {touched.description && (
                        <span style={{ position:'absolute', right:'12px', top:'14px', fontSize:'15px', pointerEvents:'none', color: errors.description ? '#ef4444' : '#22c55e' }}>
                          {errors.description ? <FaTimesCircle /> : <FaCheckCircle />}
                        </span>
                      )}
                    </div>
                    <div style={{ display:'flex', justifyContent:'space-between', alignItems:'flex-start' }}>
                      <ValidationMsg error={errors.description} touched={touched.description} />
                      <span style={{ fontSize:'11px', color: form.description.length>1000 ? '#ef4444' : S.textMuted, marginLeft:'auto', marginTop:'5px' }}>
                        {form.description.length}/1000
                      </span>
                    </div>
                  </div>

                  {/* Resume Upload */}
                  <div data-invalid={touched.resume && !!errors.resume ? 'true' : undefined}>
                    <FieldLabel text="Upload Resume (PDF/DOC/DOCX — Max 5MB)" required />
                    <div style={{ position:'relative' }}>
                      <input
                        type="file" name="resume"
                        accept=".pdf,.doc,.docx"
                        onChange={handleFileChange}
                        style={{ ...getFieldStyle(touched.resume, errors.resume), padding:'10px', cursor:'pointer' }}
                      />
                    </div>
                    <ValidationMsg error={errors.resume} touched={touched.resume} />
                    {!touched.resume && (
                      <p style={{ fontSize:'11px', color:S.textMuted, margin:'4px 0 0' }}>Choose File</p>
                    )}
                    {touched.resume && !errors.resume && form.resume && (
                      <p style={{ fontSize:'11px', color:'#16a34a', margin:'4px 0 0', display:'flex', alignItems:'center', gap:'4px' }}>
                        <FaCheckCircle /> {form.resume.name} — {(form.resume.size/1024).toFixed(0)} KB
                      </p>
                    )}
                  </div>

                  {/* Submit Button */}
                  <button
                    type="submit"
                    disabled={submitting || locked}
                    style={{
                      marginTop:'8px', padding:'18px',
                      backgroundColor: (submitting||locked) ? '#94a3b8' : S.navy,
                      color:S.white, border:'none', borderRadius:'10px',
                      fontSize:'15px', fontWeight:'bold', letterSpacing:'1px', textTransform:'uppercase',
                      cursor: (submitting||locked) ? 'not-allowed' : 'pointer',
                      display:'flex', alignItems:'center', justifyContent:'center', gap:'10px',
                      transition:'all .2s', opacity:(submitting||locked) ? .65 : 1,
                    }}
                    onMouseEnter={e => { if(!submitting && !locked){ e.currentTarget.style.backgroundColor=S.orange; e.currentTarget.style.transform='translateY(-2px)' }}}
                    onMouseLeave={e => { if(!submitting && !locked){ e.currentTarget.style.backgroundColor=S.navy; e.currentTarget.style.transform='translateY(0)' }}}
                  >
                    {submitting
                      ? <><Spinner /> Processing Application…</>
                      : <><FaPaperPlane style={{ fontSize:'13px' }} /> Submit Application</>}
                  </button>

                </div>
              </form>
            )}
          </div>

          {/* CONTACT CARD */}
          <div style={{ backgroundColor:S.navy, borderRadius:'24px', padding:'48px 40px', color:S.white, position:'relative', overflow:'hidden' }}>
            <FaUserTie style={{ position:'absolute', bottom:'-40px', right:'-40px', fontSize:'200px', color:'rgba(255,255,255,0.03)', pointerEvents:'none' }} />
            <div style={{ position:'relative', zIndex:1 }}>
              <div style={{ display:'inline-flex', alignItems:'center', gap:'12px', backgroundColor:'rgba(255,135,85,0.1)', padding:'8px 16px', borderRadius:'20px', marginBottom:'24px', border:'1px solid rgba(255,135,85,0.2)' }}>
                <div style={{ width:'8px', height:'8px', backgroundColor:S.orange, borderRadius:'50%' }} />
                <span style={{ color:S.orange, fontSize:'12px', fontWeight:'bold', letterSpacing:'1px', textTransform:'uppercase' }}>Recruitment</span>
              </div>
              <h2 style={{ fontSize:'30px', fontWeight:'bold', margin:'0 0 32px' }}>Direct Contact</h2>
              <div style={{ display:'flex', flexDirection:'column', gap:'32px' }}>
                <div style={{ display:'flex', alignItems:'flex-start', gap:'16px' }}>
                  <IconBox><HiOutlineMail style={{ color:S.orange, fontSize:'22px' }} /></IconBox>
                  <div>
                    <HQLabel>Email</HQLabel>
                    <div style={{ display:'flex', flexDirection:'column', gap:'6px' }}>
                      {['geetanjali@pislinfra.com'].map(m => (
                        <a key={m} href={`mailto:${m}`} style={{ color:'#fff', textDecoration:'none', fontSize:'14px', fontWeight:'500' }}>{m}</a>
                      ))}
                    </div>
                  </div>
                </div>
                <div style={{ display:'flex', alignItems:'flex-start', gap:'16px' }}>
                  <IconBox><HiOutlinePhone style={{ color:S.orange, fontSize:'22px' }} /></IconBox>
                  <div>
                    <HQLabel>Call</HQLabel>
                    <p style={{ margin:0, color:'#fff', fontSize:'15px', fontWeight:'500' }}>8700266398, 9319684798</p>
                  </div>
                </div>
                <div style={{ height:'1px', backgroundColor:'rgba(255,255,255,0.1)' }} />
                <div>
                  <HQLabel>Requirement</HQLabel>
                  <p style={{ margin:'0 0 16px', color:'#fff', fontSize:'15px', fontWeight:'500' }}>Warehouse / Industrial Experience</p>
                  <HQLabel>Compensation</HQLabel>
                  <p style={{ margin:0, color:'#fff', fontSize:'15px', fontWeight:'500' }}>Salary as per Industry Standard</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>

      <style>{`
        @keyframes spinDash    { to { transform: rotate(360deg); } }
        @keyframes rotateSpin  { to { transform: rotate(360deg); } }
        @keyframes successPop  {
          0%   { transform: scale(0.75) translateY(20px); opacity: 0; }
          70%  { transform: scale(1.04) translateY(-3px); opacity: 1; }
          100% { transform: scale(1)    translateY(0);    opacity: 1; }
        }
        @keyframes drawCheck { to { stroke-dashoffset: 0; } }
        @keyframes fadeUp {
          from { opacity: 0; transform: translateY(12px); }
          to   { opacity: 1; transform: translateY(0); }
        }
        @media (max-width: 960px) {
          #apply-form > div { grid-template-columns: 1fr !important; }
        }
        @media (max-width: 640px) {
          [data-row="2col"], [data-row="3col"] { grid-template-columns: 1fr !important; }
        }
      `}</style>
    </div>
  )
}

export default Careers