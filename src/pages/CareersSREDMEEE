const validStyle  = { borderColor: '#22c55e', backgroundColor: '#f0fdf4', boxShadow: '0 0 0 3px rgba(34,197,94,0.10)' }
const invalidStyle = { borderColor: '#ef4444', backgroundColor: '#fff5f5', boxShadow: '0 0 0 3px rgba(239,68,68,0.10)' }
const focusStyle   = { borderColor: '#ff8755', backgroundColor: '#ffffff', boxShadow: '0 0 0 4px rgba(255,135,85,0.10)' }

const getFieldStyle = (touched, error) => ({
  ...baseInput,
  ...(touched ? (error ? invalidStyle : validStyle) : {}),
})

