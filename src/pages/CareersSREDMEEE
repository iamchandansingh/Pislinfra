const FieldLabel = ({ text, required }) => (
  <label style={{ display:'block', fontSize:'12px', fontWeight:'700', color:'#2a2a75', letterSpacing:'0.5px', marginBottom:'8px' }}>
    {text}{required && <span style={{ color:'#ff8755' }}> *</span>}
  </label>
)

const ValidationMsg = ({ error, touched }) => {
  if (!touched) return null
  return (
    <p style={{ margin:'5px 0 0', fontSize:'11px', lineHeight:'1.4', color: error ? '#ef4444' : '#16a34a', display:'flex', alignItems:'center', gap:'4px', animation:'fadeUp .2s ease' }}>
      {error
        ? <><FaTimesCircle style={{ flexShrink:0 }} />{error}</>
        : <><FaCheckCircle style={{ flexShrink:0 }} />Looks good!</>}
    </p>
  )
}

const InlineIcon = ({ touched, error }) => {
  if (!touched) return null
  return (
    <span style={{ position:'absolute', right:'12px', top:'50%', transform:'translateY(-50%)', fontSize:'15px', pointerEvents:'none', color: error ? '#ef4444' : '#22c55e' }}>
      {error ? <FaTimesCircle /> : <FaCheckCircle />}
    </span>
  )
}

const VInput = ({ label, name, type='text', value, placeholder, maxLength, inputMode, required, error, touched, onChange, onBlur }) => {
  const handleFocus = (e) => Object.assign(e.target.style, focusStyle)
  const handleBlur  = (e) => { onBlur(e); Object.assign(e.target.style, touched && error ? invalidStyle : touched ? validStyle : { borderColor:'transparent', backgroundColor:'#f1f5f9', boxShadow:'none' }) }

  return (
    <div>
      <FieldLabel text={label} required={required} />
      <div style={{ position:'relative' }}>
        <input
          type={type} name={name} value={value}
          onChange={onChange} onBlur={handleBlur} onFocus={handleFocus}
          placeholder={placeholder} maxLength={maxLength} inputMode={inputMode}
          autoComplete="off" required={required}
          style={{ ...getFieldStyle(touched, error), paddingRight: touched ? '38px' : '16px' }}
        />
        <InlineIcon touched={touched} error={error} />
      </div>
      <ValidationMsg error={error} touched={touched} />
    </div>
  )
}

const VSelect = ({ label, name, value, required, error, touched, onChange, onBlur, children }) => {
  const handleFocus = (e) => Object.assign(e.target.style, focusStyle)
  const handleBlur  = (e) => { onBlur(e); Object.assign(e.target.style, touched && error ? invalidStyle : touched ? validStyle : { borderColor:'transparent', backgroundColor:'#f1f5f9', boxShadow:'none' }) }

  return (
    <div>
      <FieldLabel text={label} required={required} />
      <select
        name={name} value={value} onChange={onChange}
        onBlur={handleBlur} onFocus={handleFocus} required={required}
        style={getFieldStyle(touched, error)}
      >
        {children}
      </select>
      <ValidationMsg error={error} touched={touched} />
    </div>
  )
}

