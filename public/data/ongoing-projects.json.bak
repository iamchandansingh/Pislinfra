ar","category":"Building Construction","location":"Jamnagar","state":"Gujarat","area":"2 Nos. (G+12) Buildings, 2,500 Sqm per Floor","client":"Reliance Industries Limited","timeline":"2026 WIP","projectStatus":"Ongoing","scope":"Civil Construction Works for Core & Shell of TR Type Buildings No. 105 & 106.","cx":null,"cy":null,"images":[{"id":459,"documentId":"wp_media_459","name":"large_4_TR_Building_Township_Jamnagar_13bfc57dab.jpeg","alternativeText":"large_4_TR_Building_Township_Jamnagar_13bfc57dab","caption":"","width":1000,"height":563,"formats":{"thumbnail":{"url":"/images/uploads/large_4_TR_Building_Township_Jamnagar_13bfc57dab-150x150.jpeg","width":150,"height":150},"small":{"url":"/images/uploads/large_4_TR_Building_Township_Jamnagar_13bfc57dab-500x282.jpeg","width":500,"height":282},"medium":{"url":"/images/uploads/large_4_TR_Building_Township_Jamnagar_13bfc57dab-750x422.jpeg","width":750,"height":422},"large":{"url":"/images/projects/large_4_TR_Building_Township_Jamnagar_13bfc57dab.jpeg","width":1000,"height":563}},"mime":"image/jpeg","url":"/images/projects/large_4_TR_Building_Township_Jamnagar_13bfc57dab.jpeg"},{"id":460,"documentId":"wp_media_460","name":"large_1_TR_Building_Township_Jamnagar_3416f89107.jpeg","alternativeText":"large_1_TR_Building_Township_Jamnagar_3416f89107","caption":"","width":1000,"height":750,"formats":{"thumbnail":{"url":"/images/uploads/large_1_TR_Building_Township_Jamnagar_3416f89107-150x150.jpeg","width":150,"height":150},"small":{"url":"/images/uploads/large_1_TR_Building_Township_Jamnagar_3416f89107-500x375.jpeg","width":500,"height":375},"medium":{"url":"/images/uploads/large_1_TR_Building_Township_Jamnagar_3416f89107-750x563.jpeg","width":750,"height":563},"large":{"url":"/images/projects/large_1_TR_Building_Township_Jamnagar_3416f89107.jpeg","width":1000,"height":750}},"mime":"image/jpeg","url":"/images/projects/large_1_TR_Building_Township_Jamnagar_3416f89107.jpeg"},{"id":461,"documentId":"wp_media_461","name":"large_2_